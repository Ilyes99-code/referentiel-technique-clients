# Copy to .env and fill in real values before running `docker compose up`.
# .env is read automatically by docker compose — never commit the real one.

DB_NAME=referentiel
DB_USER=referentiel
DB_PASSWORD=change-me

# openssl rand -base64 32
# Both MUST decode to exactly 32 bytes — CredentialCryptoService rejects anything
# else at startup rather than running with a weak key.
#
# CREDENTIALS_SECRET is the AES-256-GCM key for stored technical-access passwords.
# Changing it after data exists makes every stored password undecryptable, so it
# is effectively permanent for the life of the database.
JWT_SECRET=change-me-base64-32-bytes
CREDENTIALS_SECRET=change-me-base64-32-bytes

# Seeded admin account, created on first boot against an empty DB.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me

# ── Host port mappings (optional) ────────────────────────────────────
# Only override these if the defaults collide with something already running.
# They affect the host side of the mapping only — inside the compose network
# nginx always reaches the API at http://backend:8082.
#FRONTEND_PORT=8080
#BACKEND_PORT=8082
#DB_PORT=5432
